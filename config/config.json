{
  "kumu": {
    "project": "jbledevehat/sites-web-gouvfr",
    "map": "liste-des-sites-web-en-gouvfr-v1"
  },
  "sources": {
    "dinum": "https://gitlab.adullact.net/dinum/noms-de-domaine-organismes-secteur-public/-/raw/master/domains.csv",
    "annuaire": {
      "url": "https://api-lannuaire.service-public.fr/api/explore/v2.1/catalog/datasets/api-lannuaire-administration",
      "excludeTypes": [
        "Ordre professionnel",
        "Association d'utilité publique",
        "Ambassade ou mission diplomatique",
        "Collectivité locale",
        "Syndicat mixte",
        "Établissement d'enseignement",
        "Institution européenne"
      ]
    },
    "operateurs": "https://static.data.gouv.fr/resources/projet-de-loi-de-finances-pour-2026-plf-2026-jaune-operateurs-de-letat-liste-des-operateurs-et-categories/20260113-145343/plf2026-jauneoperateurs.csv"
  },
  "check": {
    "concurrency": 12,
    "timeoutMs": 15000,
    "userAgent": "Mozilla/5.0 (compatible; sites-gouv-fr/0.1; +https://gouvfr.jbledevehat.fr)",
    "perIp": 1,
    "perIpGapMs": 2000
  },
  "candidates": {
    "suffix": "gouv.fr",
    "includeSubdomains": true,
    "excludePatterns": [
      "^(api|mail|smtp|imap|pop|mx|autodiscover|autoconfig|webmail|vpn|ftp|sftp|ns\\d*|dns|ldap|sso|auth|cas|proxy|relay|lyncdiscover|sip|owa|exchange|cdn|static|assets|img|media)[.-]",
      "(^|[.-])(test|tests|recette|rec|preprod|pre-prod|preproduction|staging|stg|dev|develop|demo|int|integration|qualif|qualification|formation|sandbox|uat|bac-a-sable)([.-]|\\d)",
      "^(adm|admin|administration|backoffice|bo|back|gestion|intranet|extranet|webadmin|cms|matomo|piwik|stats|analytics|grafana|kibana|prometheus|sentry|metabase|gitlab|git|jenkins|ci|argocd|rancher|k8s|kube|monitoring|status|keycloak|login|idp|oauth|s3|minio|storage|files|upload|backup|vault|db|pma|phpmyadmin|redis|elastic|es|solr|rabbitmq|remote|citrix|rdp|portainer|traefik|nexus|sonar|jira|confluence|wiki-interne)([.-]|\\d)",
      "(^|[.-])api([.-]|\\d)",
      "^(www\\d|ww\\d|wwwd|origin|lb|node|srv|server|host|vm|preview|beta\\d)[.-]"
    ],
    "dinumTypes": {
      "Ministère": "",
      "Ambassade": "Ministère de l'Europe et des Affaires étrangères",
      "Académie": "Ministère de l'Éducation nationale",
      "Université": "Ministère de l’Enseignement supérieur, de la Recherche et de l'Espace",
      "Préfécture": "Préfecture",
      "Santé": "Ministère de la Santé, des Familles, de l’Autonomie et des Personnes handicapées"
    },
    "excludeDomains": [
      "imf.org",
      "ebrd.com",
      "banquemondiale.org",
      "worldbank.org",
      "oecd.org",
      "un.org",
      "unesco.org",
      "europa.eu",
      "coe.int",
      "nato.int",
      "wto.org",
      "who.int",
      "iadb.org",
      "afdb.org",
      "adb.org",
      "eib.org",
      "ilo.org",
      "irena.org",
      "unhcr.org",
      "wfp.org",
      "fao.org",
      "iaea.org",
      "ifad.org",
      "unicef.org"
    ]
  },
  "site": {
    "domain": "gouvfr.jbledevehat.fr"
  },
  "subdomains": {
    "crtsh": {
      "host": "crt.sh",
      "database": "certwatch",
      "user": "guest"
    },
    "maxAgeDays": 30
  }
}
